# Copy to .env and fill in. Never commit a real key.

# Vision provider examples:
# TTB_VISION_PROVIDER=anthropic
# TTB_VISION_PROVIDER=fake
TTB_VISION_PROVIDER=openai

# Vision model examples:
# TTB_VISION_MODEL=claude-sonnet-4-6
# TTB_VISION_MODEL=claude-haiku-4-5
# TTB_VISION_MODEL=claude-opus-4-8
# TTB_VISION_MODEL=gpt-5.4
TTB_VISION_MODEL=gpt-5.4-mini

# Provider keys. Only the selected provider's key is required.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning
TTB_VISION_MAX_TOKENS=2048
TTB_REQUEST_TIMEOUT=30

# Copy to .env and fill in. Never commit a real key.

# Vision provider: "anthropic" (default) or "fake" (offline dev / tests, no key needed)
TTB_VISION_PROVIDER=anthropic

# Vision model. Sonnet is the default (best accuracy/latency balance). Swap as needed:
#   claude-sonnet-4-6 (default)  |  claude-haiku-4-5 (faster, less accurate on small text)  |  claude-opus-4-8 (most capable)
TTB_VISION_MODEL=claude-sonnet-4-6

# Anthropic API key (required when TTB_VISION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Optional tuning
TTB_VISION_MAX_TOKENS=2048
TTB_REQUEST_TIMEOUT=30
